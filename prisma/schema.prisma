generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int       @id @default(autoincrement())
  username   String    @unique
  password   String
  role       String    @default("CASHIER") // ADMIN, CASHIER
  permissions String   @default("[]") // JSON string array of module access like ["POS", "SALES", "INVENTORY"]
  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id])
  createdAt  DateTime  @default(now())
  transactions Transaction[]
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  requiresImei Boolean   @default(false)
  products     Product[]
}

model Client {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String?       @unique
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Location {
  id       Int       @id @default(autoincrement())
  name     String
  type     String    @default("STORE") // WAREHOUSE or STORE
  users    User[]
  items    Item[]
  transactionsSource Transaction[] @relation("SourceT")
  transactionsDest   Transaction[] @relation("TargetT")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  brand       String?
  sku         String?
  price       Float     @default(0)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  requiresImei Boolean  @default(true) // true = Phone (needs IMEI), false = Accessory (quantity based)
  items       Item[]
  createdAt   DateTime  @default(now())
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  phone     String?
  items     Item[]
  createdAt DateTime @default(now())
}

model Item {
  id             Int       @id @default(autoincrement())
  imei           String?   @unique // Optional for accessories
  status         String    @default("IN_STOCK") // IN_STOCK, SOLD, IN_TRANSIT
  productId      Int
  product        Product   @relation(fields: [productId], references: [id])
  locationId     Int?
  location       Location? @relation(fields: [locationId], references: [id])
  supplierId     Int?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  purchasePrice  Float     @default(0.0)
  quantity       Int       @default(1) // For non-IMEI items
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  transactions   TransactionItem[]
}

model Transaction {
  id               Int       @id @default(autoincrement())
  type             String    // RECEIVE, TRANSFER, SALE, RETURN
  sourceLocationId Int?
  sourceLocation   Location? @relation("SourceT", fields: [sourceLocationId], references: [id])
  targetLocationId Int?
  targetLocation   Location? @relation("TargetT", fields: [targetLocationId], references: [id])
  clientId         Int?
  client           Client?   @relation(fields: [clientId], references: [id])
  userId           Int?
  user             User?     @relation(fields: [userId], references: [id])
  items            TransactionItem[]
  createdAt        DateTime  @default(now())
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  itemId        Int
  item          Item        @relation(fields: [itemId], references: [id])
  quantity      Int         @default(1)
  price         Float       @default(0) // this is salePrice during a SALE
}
